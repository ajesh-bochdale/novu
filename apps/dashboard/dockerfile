FROM node:22.22-alpine3.23 AS builder
RUN apk add --no-cache g++ make py3-pip bash
ENV NX_DAEMON=false
ENV NR_NATIVE_METRICS_NO_BUILD=true
ENV NR_NATIVE_METRICS_NO_DOWNLOAD=true

WORKDIR /usr/src/app

RUN npm --no-update-notifier --no-fund --global install pnpm@11.0.9

COPY package.json .

COPY apps/dashboard ./apps/dashboard
COPY libs ./libs
COPY packages ./packages
COPY enterprise ./enterprise
COPY tsconfig.json .

COPY nx.json .
COPY pnpm-workspace.yaml .
COPY pnpm-lock.yaml .

RUN --mount=type=cache,id=pnpm-store-dashboard,target=/root/.pnpm-store\
  pnpm install --frozen-lockfile --unsafe-perm

ARG VITE_EE_AUTH_PROVIDER
ARG VITE_SELF_HOSTED=true
ARG VITE_NOVU_ENTERPRISE=false

ENV VITE_EE_AUTH_PROVIDER=${VITE_EE_AUTH_PROVIDER}
ENV VITE_SELF_HOSTED=${VITE_SELF_HOSTED}
ENV VITE_NOVU_ENTERPRISE=${VITE_NOVU_ENTERPRISE}

# Enterprise packages are installed in node_modules (frozen lockfile above).
# Remove their NX project.json files so NX cannot discover ee-* projects
# and hit the circular dependency (ee-auth → application-generic → testing → ee-auth).
# Also clear ^build so NX does not attempt to rebuild any workspace deps.
# CI avoids this by never checking out the enterprise submodule.
RUN find enterprise -name "project.json" -delete && \
    node -e "const fs=require('fs');const nx=JSON.parse(fs.readFileSync('nx.json'));nx.targetDefaults.build.dependsOn=[];fs.writeFileSync('nx.json',JSON.stringify(nx,null,2));"

RUN cd apps/dashboard && NODE_OPTIONS='--max-old-space-size=6144' node_modules/.bin/vite build

FROM node:22.22-alpine3.23 AS prod

ENV CI=true

RUN apk upgrade --no-cache && \
    apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main --upgrade libcrypto3 libssl3 musl musl-utils && \
    npm --no-update-notifier --no-fund --global install http-server && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

USER 1000
WORKDIR /app

COPY --chown=1000:1000 --from=builder /usr/src/app/apps/dashboard/dist /app/dist
COPY --chown=1000:1000 --from=builder /usr/src/app/apps/dashboard/package.json /app/package.json
COPY --chown=1000:1000 --from=builder /usr/src/app/apps/dashboard/docker-entrypoint.sh /app/docker-entrypoint.sh

RUN chmod +x /app/docker-entrypoint.sh
ENTRYPOINT [ "/app/docker-entrypoint.sh" ]
EXPOSE 4000
CMD [ "http-server", "dist", "-p", "4000", "-d", "false", "--proxy", "http://localhost:4000?" ]
